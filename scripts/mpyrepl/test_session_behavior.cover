    1: """Unit tests for REPL session behavior.
       
       :return: None
       """
       
    1: from __future__ import annotations
       
    1: import os
    1: import sys
    1: import unittest
       
       
    1: CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
    1: if CURRENT_DIR not in sys.path:
           sys.path.insert(0, CURRENT_DIR)
       
    1: import bootstrap
       
    1: bootstrap.configure_import_path()
       
    1: from prompt_toolkit.buffer import Buffer
    1: from prompt_toolkit.document import Document
    1: from prompt_toolkit.input import create_pipe_input
    1: from prompt_toolkit.history import InMemoryHistory
    1: from prompt_toolkit.output import DummyOutput
       
    1: from completion_engine import ReplCompleter
    1: from completion_state import ReplSessionSymbols
    1: from session import PROMPT_EXIT, build_prompt_session
       
       
    2: class SessionBehaviorTests(unittest.TestCase):
    1:     """Cover core REPL editing and completion behavior.
       
           :return: None
           """
       
    1:     def test_bare_completion_includes_builtin_and_core_names(self) -> None:
               """Builtins like range and core names like sys should be available.
       
               :return: None
               """
    1:         completer = ReplCompleter(ReplSessionSymbols())
       
    2:         range_candidates = {
    1:             item.text
    3:             for item in completer.get_completions(Document(text="ran", cursor_position=3), None)
               }
    2:         sys_candidates = {
    1:             item.text
    3:             for item in completer.get_completions(Document(text="sy", cursor_position=2), None)
               }
       
    1:         self.assertIn("range", range_candidates)
    1:         self.assertIn("sys", sys_candidates)
       
    1:     def test_auto_up_recalls_whole_multiline_history_entry(self) -> None:
               """Up on the first line should recall the previous whole block.
       
               :return: None
               """
    1:         history = InMemoryHistory()
    1:         block = "def f():\n    return 1"
    1:         history.append_string(block)
       
    1:         buffer = Buffer(history=history, multiline=True)
    1:         buffer._working_lines.appendleft(block)
    1:         buffer.working_index = 1
    1:         buffer.text = ""
       
    1:         buffer.auto_up()
       
    1:         self.assertEqual(buffer.text, block)
    1:         self.assertEqual(buffer.document.cursor_position, len(block))
       
    1:     def test_auto_up_moves_inside_current_multiline_block_before_history(self) -> None:
               """Up inside a multiline block should move the cursor, not swap history.
       
               :return: None
               """
    1:         block = "def f():\n    return 1"
    2:         buffer = Buffer(
    1:             history=InMemoryHistory(),
    1:             multiline=True,
    1:             document=Document(block, cursor_position=len(block)),
               )
       
    1:         original_text = buffer.text
    1:         original_row = buffer.document.cursor_position_row
    1:         buffer.auto_up()
       
    1:         self.assertEqual(buffer.text, original_text)
    1:         self.assertEqual(original_row, 1)
    1:         self.assertEqual(buffer.document.cursor_position_row, 0)
       
    1:     def test_up_key_recalls_whole_history_block_in_prompt_session(self) -> None:
               """Up on a new block should recall the previous whole block.
       
               :return: None
               """
    1:         history = InMemoryHistory()
    1:         block = "def f():\n    return 1"
    1:         history.append_string(block)
       
    2:         with create_pipe_input() as pipe:
    1:             session = build_prompt_session(history=history, input=pipe, output=DummyOutput())
    1:             pipe.send_bytes(b"\x1b[A\x18")
    2:             result = session.prompt(
    1:                 ">>> ",
    2:                 pre_run=lambda: session.default_buffer.load_history_if_not_yet_loaded(),
                   )
       
    1:         self.assertEqual(result, PROMPT_EXIT)
    1:         self.assertEqual(session.default_buffer.text, block)
       
    1:     def test_submitted_multiline_block_is_recorded_into_history(self) -> None:
               """Accepted multiline input should be available to the next Up key recall.
       
               :return: None
               """
    1:         history = InMemoryHistory()
       
    2:         with create_pipe_input() as pipe:
    1:             session = build_prompt_session(history=history, input=pipe, output=DummyOutput())
    1:             pipe.send_text("def f():\rreturn 1\r\r")
    1:             first = session.prompt(">>> ")
       
    1:             pipe.send_bytes(b"\x1b[A\x18")
    2:             second = session.prompt(
    1:                 ">>> ",
    2:                 pre_run=lambda: session.default_buffer.load_history_if_not_yet_loaded(),
                   )
       
    1:         self.assertEqual(first, "def f():\n    return 1")
    1:         self.assertEqual(second, PROMPT_EXIT)
    1:         self.assertEqual(session.default_buffer.text, "def f():\n    return 1")
       
       
    1: if __name__ == "__main__":
           unittest.main()
