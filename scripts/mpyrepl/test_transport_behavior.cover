    1: from models import ReplConfig
    1: from transport import SerialReplTransport, TransportError
       
       
    2: class _FakeSerial:
    1:     """Minimal serial stub used for transport error tests.
       
           :return: None
           """
       
    1:     def __init__(self) -> None:
               """Initialize captured writes.
       
               :return: None
               """
    1:         self.writes: list[bytes] = []
       
    1:     def write(self, data: bytes) -> None:
