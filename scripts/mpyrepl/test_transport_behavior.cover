               """
    2:         self.writes.append(data)
       
       
    2: class TransportBehaviorTests(unittest.TestCase):
    1:     """Cover transport diagnostics for raw REPL entry failures.
       
           :return: None
           """
       
    1:     def test_enter_raw_repl_error_includes_observed_bytes(self) -> None:
               """Raw REPL entry errors should surface captured device bytes.
       
               :return: None
               """
    1:         transport = SerialReplTransport(ReplConfig(port="COM4"))
    1:         transport._serial = _FakeSerial()
    2:         transport.drain_input = lambda: None
