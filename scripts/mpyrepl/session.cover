    1: """Prompt toolkit session helpers for Spike B.
       
       :return: None
       """
       
    1: from __future__ import annotations
       
    1: from prompt_toolkit import PromptSession
    1: from prompt_toolkit.completion import CompleteEvent, get_common_complete_suffix
    1: from prompt_toolkit.document import Document
    1: from prompt_toolkit.key_binding import KeyBindings
    1: from prompt_toolkit.history import InMemoryHistory
    1: from prompt_toolkit.lexers import PygmentsLexer
    1: from pygments.lexers.python import PythonLexer
       
    1: from indent import INDENT, continuation_default, is_block_complete
       
       
    1: PROMPT_SOFT_RESET = "__mpyrepl_soft_reset__"
    1: PROMPT_EXIT = "__mpyrepl_exit__"
       
       
    1: def _should_insert_indent(document: Document) -> bool:
           """Return whether Tab should insert spaces instead of requesting completion.
       
           :param document: Prompt document.
           :return: True when the cursor is still inside leading whitespace.
           """
           line_before_cursor = document.current_line_before_cursor
           return not line_before_cursor or line_before_cursor.isspace()
       
       
    1: def _dedent_backspace_count(document: Document) -> int:
           """Return how many spaces Backspace should delete for one dedent step.
       
           :param document: Prompt document.
           :return: Delete count, or zero for normal Backspace handling.
           """
           line_before_cursor = document.current_line_before_cursor
           if not line_before_cursor or not line_before_cursor.isspace():
               return 0
       
           indent_width = len(line_before_cursor)
           indent_step = len(INDENT)
           remainder = indent_width % indent_step
           return remainder or indent_step
       
       
    1: def _continuation_after_newline(document: Document) -> str:
           """Return the indent that should be inserted after Enter.
       
           :param document: Prompt document.
           :return: Indentation prefix for the new line.
           """
    2:     lines = document.text_before_cursor.split("\n")
    2:     return continuation_default(lines)
       
       
    1: def _should_accept_on_enter(document: Document) -> bool:
           """Return whether Enter should submit the buffer instead of inserting a newline.
       
           :param document: Prompt document.
           :return: True when the current buffer should be accepted.
           """
    3:     text = document.text
    3:     if not text:
               return True
       
    3:     if "\n" not in text:
    1:         return document.cursor_position == len(text) and is_block_complete(text)
       
    2:     if document.cursor_position != len(text):
               return False
    2:     return document.current_line.strip() == ""
       
       
    1: def build_prompt_session(completer=None, history=None, input=None, output=None) -> PromptSession:
           """Create the minimal prompt_toolkit session for the prompt spike.
       
           :param completer: Optional prompt_toolkit completer.
           :param history: Optional prompt_toolkit history object.
           :param input: Optional prompt_toolkit input object for tests.
           :param output: Optional prompt_toolkit output object for tests.
           :return: Prompt session instance.
           """
    2:     bindings = KeyBindings()
       
    4:     @bindings.add("c-d")
    4:     def _request_soft_reset(event) -> None:
               event.app.exit(result=PROMPT_SOFT_RESET)
       
    4:     @bindings.add("c-]")
    4:     def _request_exit(event) -> None:
               event.app.exit(result=PROMPT_EXIT)
       
    4:     @bindings.add("c-x")
    4:     def _request_exit_via_ctrl_x(event) -> None:
    2:         event.app.exit(result=PROMPT_EXIT)
       
    4:     @bindings.add("up")
    4:     def _handle_up(event) -> None:
    2:         event.current_buffer.load_history_if_not_yet_loaded()
    2:         event.current_buffer.auto_up()
       
    4:     @bindings.add("down")
    4:     def _handle_down(event) -> None:
               event.current_buffer.load_history_if_not_yet_loaded()
               event.current_buffer.auto_down()
       
    4:     @bindings.add("enter")
    4:     def _handle_enter(event) -> None:
    3:         buffer = event.current_buffer
    3:         if buffer.complete_state and buffer.complete_state.current_completion is not None:
                   buffer.apply_completion(buffer.complete_state.current_completion)
                   return
       
    3:         document = buffer.document
    3:         if _should_accept_on_enter(document):
    1:             accepted_text = buffer.text.rstrip()
    1:             if accepted_text != buffer.text:
    1:                 buffer.document = Document(accepted_text, cursor_position=len(accepted_text))
    1:             buffer.append_to_history()
    1:             event.app.exit(result=accepted_text)
    1:             return
       
    2:         buffer.insert_text("\n" + _continuation_after_newline(document))
       
    4:     @bindings.add("tab")
    4:     def _handle_tab(event) -> None:
               buffer = event.current_buffer
               if buffer.complete_state:
                   buffer.complete_next()
                   return
       
               document = buffer.document
               if _should_insert_indent(document):
                   buffer.insert_text(INDENT)
                   return
       
               if completer is not None and getattr(completer, "has_completion_target", None):
                   if completer.has_completion_target(document):
                       completions = list(
                           completer.get_completions(
                               document,
                               CompleteEvent(completion_requested=True),
                           )
                       )
                       if len(completions) == 1:
                           buffer.apply_completion(completions[0])
                           return
       
                       common_suffix = get_common_complete_suffix(document, completions)
                       if common_suffix:
                           buffer.insert_text(common_suffix)
                           return
       
                       if completions:
                           buffer._set_completions(completions)
                           return
       
                       buffer.insert_text(INDENT)
                       return
       
               buffer.insert_text(INDENT)
       
    4:     @bindings.add("backspace")
    4:     def _handle_backspace(event) -> None:
               buffer = event.current_buffer
               delete_count = _dedent_backspace_count(buffer.document)
               if delete_count > 0:
                   buffer.delete_before_cursor(count=delete_count)
                   return
               buffer.delete_before_cursor(count=1)
       
    4:     return PromptSession(
    2:         lexer=PygmentsLexer(PythonLexer),
    2:         multiline=True,
   25:         prompt_continuation=lambda width, line_number, wrap_count: "... ",
    2:         history=history or InMemoryHistory(),
    2:         key_bindings=bindings,
    2:         completer=completer,
    2:         complete_in_thread=False,
    2:         input=input,
    2:         output=output,
           )
