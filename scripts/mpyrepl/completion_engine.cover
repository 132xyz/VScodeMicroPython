    4:     return {
  640:         name
  324:         for name in dir(py_builtins)
  640:         if name and not name.startswith("__")
           }
       
       
    1: def cursor_in_string_or_comment(line_before_cursor: str) -> bool:
           """Return whether the cursor is currently inside a string or comment.
       
           :param line_before_cursor: Current line text before the cursor.
           :return: True when completion should be disabled.
           """
    2:     if not line_before_cursor:
               return False
       
    2:     try:
    2:         tokens = list(tokenize.generate_tokens(io.StringIO(line_before_cursor).readline))
           except tokenize.TokenError:
               return True
       
    2:     if not tokens:
               return False
       
    2:     return tokens[-1].type in (tokenize.STRING, tokenize.COMMENT)
       
       
    1: def parse_completion_request(document: Document) -> CompletionRequest | None:
           """Parse the completion target at the current cursor position.
       
           :param document: Prompt document.
           :return: Parsed completion request or None.
           """
    2:     line_before_cursor = document.current_line_before_cursor
    2:     if cursor_in_string_or_comment(line_before_cursor):
               return None
       
    2:     dotted_match = DOTTED_PATTERN.search(line_before_cursor)
    2:     if dotted_match is not None:
               return CompletionRequest(
                   kind="dotted",
                   expression=dotted_match.group(1),
                   prefix=dotted_match.group(2),
               )
       
    2:     meta_match = META_PATTERN.search(line_before_cursor)
    2:     if meta_match is not None:
               return CompletionRequest(kind="meta", expression="", prefix=meta_match.group(1))
       
    2:     bare_match = BARE_PATTERN.search(line_before_cursor)
    2:     if bare_match is not None:
    2:         return CompletionRequest(kind="bare", expression="", prefix=bare_match.group(1))
       
           return None
       
       
    2: class ReplCompleter(Completer):
    1:     """Serve local and optional device-backed completions for the custom REPL.
       
           :return: None
           """
       
    1:     def __init__(
               self,
