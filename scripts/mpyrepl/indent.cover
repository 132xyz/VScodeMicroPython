    1: """Indentation helpers for the custom REPL.
       
       :return: None
       """
       
    1: from __future__ import annotations
       
    1: import codeop
       
       
    1: INDENT = "    "
       
       
    1: def leading_indent_prefix(line: str) -> str:
           """Return the leading whitespace prefix of one line.
       
           :param line: Source line.
           :return: Leading whitespace prefix.
           """
    2:     indent_width = len(line) - len(line.lstrip(" \t"))
    2:     return line[:indent_width]
       
       
    1: def continuation_default(lines: list[str]) -> str:
           """Compute the suggested indent prefix for the next line.
       
           :param lines: Buffered source lines.
           :return: Suggested indent prefix.
           """
    2:     if not lines:
               return ""
       
    2:     previous = lines[-1].rstrip()
    2:     prefix = leading_indent_prefix(previous)
    2:     if previous.endswith(":"):
    1:         return prefix + INDENT
    1:     return prefix
       
       
    1: def should_start_multiline(line: str) -> bool:
           """Return whether a single entered line opens a multi-line block.
       
           :param line: Source line without a trailing newline.
           :return: True when more input is required.
           """
           try:
               return codeop.compile_command(line, symbol="exec") is None
           except (OverflowError, SyntaxError, ValueError):
               return False
       
       
    1: def is_block_complete(source: str) -> bool:
           """Return whether the current source can be submitted as one block.
       
           :param source: Full source block.
           :return: True when compile_command considers the block complete.
           """
    1:     if not source.strip():
               return True
       
    1:     try:
    1:         return codeop.compile_command(source, symbol="exec") is not None
           except (OverflowError, SyntaxError, ValueError):
               return True
