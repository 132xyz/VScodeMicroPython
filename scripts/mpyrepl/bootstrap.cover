    1: """Bootstrap helpers for standalone script execution.
       
       :return: None
       """
       
    1: from __future__ import annotations
       
    1: import os
    1: import sys
       
       
    1: def configure_import_path() -> None:
           """Add the local directory and optional vendor directory to sys.path.
       
           :return: None
           """
    2:     current_dir = os.path.dirname(os.path.abspath(__file__))
    2:     vendor_dir = os.path.join(current_dir, "_vendor")
       
    2:     if current_dir not in sys.path:
               sys.path.insert(0, current_dir)
       
    2:     if os.path.isdir(vendor_dir) and vendor_dir not in sys.path:
               # Vendored dependencies must win over user-installed packages.
    1:         sys.path.insert(0, vendor_dir)
