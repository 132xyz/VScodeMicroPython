    1: __all__ = ["PlainTextOutput"]
       
       
    2: class PlainTextOutput(Output):
    1:     """
           Output that won't include any ANSI escape sequences.
       
           Useful when stdout is not a terminal. Maybe stdout is redirected to a file.
           In this case, if `print_formatted_text` is used, for instance, we don't
           want to include formatting.
       
           (The code is mostly identical to `Vt100_Output`, but without the
           formatting.)
           """
       
    1:     def __init__(self, stdout: TextIO) -> None:
               assert all(hasattr(stdout, a) for a in ("write", "flush"))
       
               self.stdout: TextIO = stdout
               self._buffer: list[str] = []
       
    1:     def fileno(self) -> int:
               "There is no sensible default for fileno()."
               return self.stdout.fileno()
       
    1:     def encoding(self) -> str:
               return "utf-8"
       
    1:     def write(self, data: str) -> None:
               self._buffer.append(data)
       
    1:     def write_raw(self, data: str) -> None:
               self._buffer.append(data)
       
    1:     def set_title(self, title: str) -> None:
               pass
       
    1:     def clear_title(self) -> None:
               pass
       
    1:     def flush(self) -> None:
               if not self._buffer:
                   return
       
               data = "".join(self._buffer)
               self._buffer = []
               flush_stdout(self.stdout, data)
       
    1:     def erase_screen(self) -> None:
               pass
       
    1:     def enter_alternate_screen(self) -> None:
               pass
       
    1:     def quit_alternate_screen(self) -> None:
               pass
       
