    1: def html_escape(text: object) -> str:
           # The string interpolation functions also take integers and other types.
           # Convert to string first.
           if not isinstance(text, str):
               text = f"{text}"
       
           return (
               text.replace("&", "&amp;")
               .replace("<", "&lt;")
               .replace(">", "&gt;")
               .replace('"', "&quot;")
           )
       
       
    1: FORMATTER = HTMLFormatter()
