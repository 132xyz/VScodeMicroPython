    1: """
       Base classes for prompt_toolkit lexers.
       """
       
    1: from __future__ import annotations
       
    1: from abc import ABCMeta, abstractmethod
    1: from typing import Callable, Hashable
       
    1: from prompt_toolkit.document import Document
    1: from prompt_toolkit.formatted_text.base import StyleAndTextTuples
       
    1: __all__ = [
           "Lexer",
           "SimpleLexer",
           "DynamicLexer",
       ]
       
       
    2: class Lexer(metaclass=ABCMeta):
    1:     """
           Base class for all lexers.
           """
       
    2:     @abstractmethod
    2:     def lex_document(self, document: Document) -> Callable[[int], StyleAndTextTuples]:
               """
               Takes a :class:`~prompt_toolkit.document.Document` and returns a
               callable that takes a line number and returns a list of
               ``(style_str, text)`` tuples for that line.
       
               XXX: Note that in the past, this was supposed to return a list
                    of ``(Token, text)`` tuples, just like a Pygments lexer.
               """
       
    1:     def invalidation_hash(self) -> Hashable:
               """
               When this changes, `lex_document` could give a different output.
               (Only used for `DynamicLexer`.)
               """
               return id(self)
       
       
    2: class SimpleLexer(Lexer):
    1:     """
           Lexer that doesn't do any tokenizing and returns the whole input as one
           token.
       
           :param style: The style string for this lexer.
           """
       
    1:     def __init__(self, style: str = "") -> None:
    8:         self.style = style
       
    1:     def lex_document(self, document: Document) -> Callable[[int], StyleAndTextTuples]:
               lines = document.lines
       
               def get_line(lineno: int) -> StyleAndTextTuples:
                   "Return the tokens for the given line."
                   try:
                       return [(self.style, lines[lineno])]
                   except IndexError:
                       return []
       
               return get_line
       
       
    2: class DynamicLexer(Lexer):
    1:     """
           Lexer class that can dynamically returns any Lexer.
       
           :param get_lexer: Callable that returns a :class:`.Lexer` instance.
           """
       
    1:     def __init__(self, get_lexer: Callable[[], Lexer | None]) -> None:
    2:         self.get_lexer = get_lexer
    2:         self._dummy = SimpleLexer()
       
    1:     def lex_document(self, document: Document) -> Callable[[int], StyleAndTextTuples]:
    4:         lexer = self.get_lexer() or self._dummy
    4:         return lexer.lex_document(document)
       
    1:     def invalidation_hash(self) -> Hashable:
   36:         lexer = self.get_lexer() or self._dummy
   36:         return id(lexer)
