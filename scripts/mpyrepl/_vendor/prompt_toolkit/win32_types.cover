    1: from __future__ import annotations
       
    1: from ctypes import Structure, Union, c_char, c_long, c_short, c_ulong
    1: from ctypes.wintypes import BOOL, DWORD, LPVOID, WCHAR, WORD
    1: from typing import TYPE_CHECKING
       
       # Input/Output standard device numbers. Note that these are not handle objects.
       # It's the `windll.kernel32.GetStdHandle` system call that turns them into a
       # real handle object.
    1: STD_INPUT_HANDLE = c_ulong(-10)
    1: STD_OUTPUT_HANDLE = c_ulong(-11)
    1: STD_ERROR_HANDLE = c_ulong(-12)
       
       
    2: class COORD(Structure):
    1:     """
           Struct in wincon.h
           http://msdn.microsoft.com/en-us/library/windows/desktop/ms682119(v=vs.85).aspx
           """
       
    1:     if TYPE_CHECKING:
               X: int
               Y: int
       
    1:     _fields_ = [
    1:         ("X", c_short),  # Short
    1:         ("Y", c_short),  # Short
           ]
       
    1:     def __repr__(self) -> str:
               return "{}(X={!r}, Y={!r}, type_x={!r}, type_y={!r})".format(
                   self.__class__.__name__,
                   self.X,
                   self.Y,
                   type(self.X),
                   type(self.Y),
               )
       
       
    2: class UNICODE_OR_ASCII(Union):
    1:     if TYPE_CHECKING:
               AsciiChar: bytes
               UnicodeChar: str
       
    1:     _fields_ = [
    1:         ("AsciiChar", c_char),
    1:         ("UnicodeChar", WCHAR),
           ]
       
       
