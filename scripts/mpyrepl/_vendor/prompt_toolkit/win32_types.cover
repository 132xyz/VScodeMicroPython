    2: class CONSOLE_SCREEN_BUFFER_INFO(Structure):
    1:     """struct in wincon.h."""
       
    1:     if TYPE_CHECKING:
               dwSize: COORD
               dwCursorPosition: COORD
               wAttributes: int
               srWindow: SMALL_RECT
               dwMaximumWindowSize: COORD
       
    1:     _fields_ = [
    1:         ("dwSize", COORD),
    1:         ("dwCursorPosition", COORD),
    1:         ("wAttributes", WORD),
    1:         ("srWindow", SMALL_RECT),
    1:         ("dwMaximumWindowSize", COORD),
           ]
       
    1:     def __repr__(self) -> str:
               return "CONSOLE_SCREEN_BUFFER_INFO({!r},{!r},{!r},{!r},{!r},{!r},{!r},{!r},{!r},{!r},{!r})".format(
                   self.dwSize.Y,
                   self.dwSize.X,
                   self.dwCursorPosition.Y,
                   self.dwCursorPosition.X,
                   self.wAttributes,
                   self.srWindow.Top,
                   self.srWindow.Left,
                   self.srWindow.Bottom,
                   self.srWindow.Right,
                   self.dwMaximumWindowSize.Y,
                   self.dwMaximumWindowSize.X,
               )
       
       
