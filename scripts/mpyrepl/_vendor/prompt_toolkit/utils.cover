    1:     def __init__(
               self, sender: _Sender, handler: Callable[[_Sender], None] | None = None
           ) -> None:
   52:         self.sender = sender
   52:         self._handlers: list[Callable[[_Sender], None]] = []
       
   52:         if handler is not None:
