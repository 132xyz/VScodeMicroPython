    1: def take_using_weights(
           items: list[_T], weights: list[int]
       ) -> Generator[_T, None, None]:
           """
           Generator that keeps yielding items from the items list, in proportion to
           their weight. For instance::
       
               # Getting the first 70 items from this generator should have yielded 10
               # times A, 20 times B and 40 times C, all distributed equally..
               take_using_weights(['A', 'B', 'C'], [5, 10, 20])
       
           :param items: List of items to take from.
           :param weights: Integers representing the weight. (Numbers have to be
                           integers, not floats.)
           """
   18:     assert len(items) == len(weights)
   18:     assert len(items) > 0
       
           # Remove items with zero-weight.
   18:     items2 = []
   18:     weights2 = []
  162:     for item, w in zip(items, weights):
  144:         if w > 0:
  144:             items2.append(item)
  144:             weights2.append(w)
       
   18:     items = items2
   18:     weights = weights2
       
           # Make sure that we have some items left.
   18:     if not items:
               raise ValueError("Did't got any items with a positive weight.")
       
           #
  162:     already_taken = [0 for i in items]
   18:     item_count = len(items)
   18:     max_weight = max(weights)
       
   18:     i = 0
  434:     while True:
               # Each iteration of this loop, we fill up until by (total_weight/max_weight).
  434:         adding = True
 1248:         while adding:
  832:             adding = False
       
 7380:             for item_i, item, weight in zip(range(item_count), items, weights):
 6566:                 if already_taken[item_i] < i * weight / float(max_weight):
 3238:                     yield item
 3220:                     already_taken[item_i] += 1
 3220:                     adding = True
       
  416:         i += 1
       
       
    1: def to_str(value: Callable[[], str] | str) -> str:
           "Turn callable or string into string."
   64:     if callable(value):
               return to_str(value())
