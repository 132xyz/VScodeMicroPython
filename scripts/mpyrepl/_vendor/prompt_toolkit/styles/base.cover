               return default
       
    1:     def invalidation_hash(self) -> Hashable:
   50:         return 1  # Always the same value.
       
    2:     @property
    2:     def style_rules(self) -> list[tuple[str, str]]:
    2:         return []
       
       
    2: class DynamicStyle(BaseStyle):
    1:     """
           Style class that can dynamically returns an other Style.
       
           :param get_style: Callable that returns a :class:`.Style` instance.
           """
       
    1:     def __init__(self, get_style: Callable[[], BaseStyle | None]):
    6:         self.get_style = get_style
    6:         self._dummy = DummyStyle()
       
    1:     def get_attrs_for_style_str(
    1:         self, style_str: str, default: Attrs = DEFAULT_ATTRS
           ) -> Attrs:
               style = self.get_style() or self._dummy
       
               return style.get_attrs_for_style_str(style_str, default)
       
    1:     def invalidation_hash(self) -> Hashable:
  150:         return (self.get_style() or self._dummy).invalidation_hash()
       
    2:     @property
    2:     def style_rules(self) -> list[tuple[str, str]]:
    6:         return (self.get_style() or self._dummy).style_rules
