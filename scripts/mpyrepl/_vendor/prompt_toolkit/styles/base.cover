       #: The default `Attrs`.
    2: DEFAULT_ATTRS = Attrs(
    1:     color="",
    1:     bgcolor="",
    1:     bold=False,
    1:     underline=False,
    1:     strike=False,
    1:     italic=False,
    1:     blink=False,
    1:     reverse=False,
