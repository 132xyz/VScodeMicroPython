    1: """
       Abstraction of CLI Input.
       """
       
    1: from __future__ import annotations
       
    1: from abc import ABCMeta, abstractmethod
    1: from contextlib import contextmanager
    1: from typing import Callable, ContextManager, Generator
       
    1: from prompt_toolkit.key_binding import KeyPress
       
    1: __all__ = [
           "Input",
           "PipeInput",
           "DummyInput",
       ]
       
       
    2: class Input(metaclass=ABCMeta):
    1:     """
           Abstraction for any input.
       
           An instance of this class can be given to the constructor of a
           :class:`~prompt_toolkit.application.Application` and will also be
           passed to the :class:`~prompt_toolkit.eventloop.base.EventLoop`.
           """
       
    2:     @abstractmethod
    2:     def fileno(self) -> int:
               """
               Fileno for putting this in an event loop.
               """
       
    2:     @abstractmethod
    2:     def typeahead_hash(self) -> str:
               """
               Identifier for storing type ahead key presses.
               """
       
    2:     @abstractmethod
    2:     def read_keys(self) -> list[KeyPress]:
               """
               Return a list of Key objects which are read/parsed from the input.
               """
       
    1:     def flush_keys(self) -> list[KeyPress]:
               """
               Flush the underlying parser. and return the pending keys.
               (Used for vt100 input.)
               """
               return []
       
    1:     def flush(self) -> None:
               "The event loop can call this when the input has to be flushed."
               pass
       
    2:     @property
    2:     @abstractmethod
    2:     def closed(self) -> bool:
               "Should be true when the input stream is closed."
               return False
       
    2:     @abstractmethod
    2:     def raw_mode(self) -> ContextManager[None]:
               """
               Context manager that turns the input into raw mode.
               """
       
    2:     @abstractmethod
    2:     def cooked_mode(self) -> ContextManager[None]:
               """
               Context manager that turns the input into cooked mode.
               """
       
    2:     @abstractmethod
    2:     def attach(self, input_ready_callback: Callable[[], None]) -> ContextManager[None]:
               """
               Return a context manager that makes this input active in the current
               event loop.
               """
       
    2:     @abstractmethod
    2:     def detach(self) -> ContextManager[None]:
               """
               Return a context manager that makes sure that this input is not active
               in the current event loop.
               """
       
    1:     def close(self) -> None:
               "Close input."
               pass
       
       
    2: class PipeInput(Input):
    1:     """
           Abstraction for pipe input.
           """
       
    2:     @abstractmethod
    2:     def send_bytes(self, data: bytes) -> None:
               """Feed byte string into the pipe"""
       
    2:     @abstractmethod
    2:     def send_text(self, data: str) -> None:
               """Feed a text string into the pipe"""
       
       
    2: class DummyInput(Input):
    1:     """
           Input for use in a `DummyApplication`
       
           If used in an actual application, it will make the application render
           itself once and exit immediately, due to an `EOFError`.
           """
       
    1:     def fileno(self) -> int:
               raise NotImplementedError
       
    1:     def typeahead_hash(self) -> str:
               return f"dummy-{id(self)}"
       
    1:     def read_keys(self) -> list[KeyPress]:
               return []
       
    2:     @property
    2:     def closed(self) -> bool:
               # This needs to be true, so that the dummy input will trigger an
               # `EOFError` immediately in the application.
               return True
       
    1:     def raw_mode(self) -> ContextManager[None]:
               return _dummy_context_manager()
       
    1:     def cooked_mode(self) -> ContextManager[None]:
               return _dummy_context_manager()
       
    1:     def attach(self, input_ready_callback: Callable[[], None]) -> ContextManager[None]:
               # Call the callback immediately once after attaching.
               # This tells the callback to call `read_keys` and check the
               # `input.closed` flag, after which it won't receive any keys, but knows
               # that `EOFError` should be raised. This unblocks `read_from_input` in
               # `application.py`.
               input_ready_callback()
       
               return _dummy_context_manager()
       
    1:     def detach(self) -> ContextManager[None]:
               return _dummy_context_manager()
       
       
    2: @contextmanager
    2: def _dummy_context_manager() -> Generator[None, None, None]:
           yield
