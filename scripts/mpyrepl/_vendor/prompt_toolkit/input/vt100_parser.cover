   16:                     if not found:
   16:                         self._call_handler(prefix[0], prefix[0])
   16:                         prefix = prefix[1:]
       
    1:     def _call_handler(
               self, key: str | Keys | tuple[Keys, ...], insert_text: str
           ) -> None:
               """
               Callback to handler.
