   47:         while True:
   47:             flush = False
       
   47:             if retry:
   16:                 retry = False
                   else:
                       # Get next character.
   31:                 c = yield
       
   29:                 if isinstance(c, _Flush):
    2:                     flush = True
                       else:
   27:                     prefix += c
       
                   # If we have some data, check for matches.
   45:             if prefix:
