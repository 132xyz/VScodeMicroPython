           # Lookup table of ANSI escape sequences for a VT100 terminal
           # Hint: in order to know what sequences your terminal writes to stdin, run
           #       "od -c" and start typing.
    1:     def __init__(self, feed_key_callback: Callable[[KeyPress], None]) -> None:
    2:         self.feed_key_callback = feed_key_callback
    2:         self.reset()
       
    1:     def reset(self, request: bool = False) -> None:
