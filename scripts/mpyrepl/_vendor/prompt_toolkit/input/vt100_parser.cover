               # Otherwise, use the mappings.
   43:         try:
   43:             return ANSI_SEQUENCES[prefix]
   34:         except KeyError:
   34:             return None
       
    1:     def _input_parser_generator(self) -> Generator[None, str | _Flush, None]:
               """
