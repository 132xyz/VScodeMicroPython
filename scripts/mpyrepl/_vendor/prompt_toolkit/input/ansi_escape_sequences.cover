    1: def _get_reverse_ansi_sequences() -> dict[Keys, str]:
           """
           Create a dictionary that maps prompt_toolkit keys back to the VT100 escape
           sequences.
           """
    1:     result: dict[Keys, str] = {}
       
  243:     for sequence, key in ANSI_SEQUENCES.items():
  242:         if not isinstance(key, tuple):
  180:             if key not in result:
  141:                 result[key] = sequence
       
    1:     return result
       
       
    1: REVERSE_ANSI_SEQUENCES = _get_reverse_ansi_sequences()
