    2:         self.named_registers: dict[str, ClipboardData] = {}
       
               #: The Vi mode we're currently in to.
    2:         self.__input_mode = InputMode.INSERT
       
               #: Waiting for digraph.
    2:         self.waiting_for_digraph = False
    2:         self.digraph_symbol1: str | None = None  # (None or a symbol.)
       
               #: When true, make ~ act as an operator.
    2:         self.tilde_operator = False
       
               #: Register in which we are recording a macro.
