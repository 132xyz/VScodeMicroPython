    2:         self.temporary_navigation_mode = False
       
    2:     @property
    2:     def input_mode(self) -> InputMode:
               "Get `InputMode`."
               return self.__input_mode
       
    2:     @input_mode.setter
    2:     def input_mode(self, value: InputMode) -> None:
               "Set `InputMode`."
    5:         if value == InputMode.NAVIGATION:
                   self.waiting_for_digraph = False
                   self.operator_func = None
                   self.operator_arg = None
       
    5:         self.__input_mode = value
       
    1:     def reset(self) -> None:
               """
               Reset state, go back to the given mode. INSERT by default.
