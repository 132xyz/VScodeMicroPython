    1: """
       Key bindings for extra page navigation: bindings for up/down scrolling through
       long pages, like in Emacs or Vi.
       """
       
    1: from __future__ import annotations
       
    1: from prompt_toolkit.filters import buffer_has_focus, emacs_mode, vi_mode
    1: from prompt_toolkit.key_binding.key_bindings import (
           ConditionalKeyBindings,
           KeyBindings,
           KeyBindingsBase,
           merge_key_bindings,
       )
       
    1: from .scroll import (
           scroll_backward,
           scroll_forward,
           scroll_half_page_down,
           scroll_half_page_up,
           scroll_one_line_down,
           scroll_one_line_up,
           scroll_page_down,
           scroll_page_up,
       )
       
    1: __all__ = [
           "load_page_navigation_bindings",
           "load_emacs_page_navigation_bindings",
           "load_vi_page_navigation_bindings",
       ]
       
       
    1: def load_page_navigation_bindings() -> KeyBindingsBase:
           """
           Load both the Vi and Emacs bindings for page navigation.
           """
           # Only enable when a `Buffer` is focused, otherwise, we would catch keys
           # when another widget is focused (like for instance `c-d` in a
           # ptterm.Terminal).
    4:     return ConditionalKeyBindings(
    4:         merge_key_bindings(
    2:             [
    2:                 load_emacs_page_navigation_bindings(),
    2:                 load_vi_page_navigation_bindings(),
                   ]
               ),
    2:         buffer_has_focus,
           )
       
       
    1: def load_emacs_page_navigation_bindings() -> KeyBindingsBase:
           """
           Key bindings, for scrolling up and down through pages.
           This are separate bindings, because GNU readline doesn't have them.
           """
    2:     key_bindings = KeyBindings()
    2:     handle = key_bindings.add
       
    2:     handle("c-v")(scroll_page_down)
    2:     handle("pagedown")(scroll_page_down)
    2:     handle("escape", "v")(scroll_page_up)
    2:     handle("pageup")(scroll_page_up)
       
    2:     return ConditionalKeyBindings(key_bindings, emacs_mode)
       
       
    1: def load_vi_page_navigation_bindings() -> KeyBindingsBase:
           """
           Key bindings, for scrolling up and down through pages.
           This are separate bindings, because GNU readline doesn't have them.
           """
    2:     key_bindings = KeyBindings()
    2:     handle = key_bindings.add
       
    2:     handle("c-f")(scroll_forward)
    2:     handle("c-b")(scroll_backward)
    2:     handle("c-d")(scroll_half_page_down)
    2:     handle("c-u")(scroll_half_page_up)
    2:     handle("c-e")(scroll_one_line_down)
    2:     handle("c-y")(scroll_one_line_up)
    2:     handle("pagedown")(scroll_page_down)
    2:     handle("pageup")(scroll_page_up)
       
    2:     return ConditionalKeyBindings(key_bindings, vi_mode)
