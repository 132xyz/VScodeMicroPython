    1: """
       Key bindings for auto suggestion (for fish-style auto suggestion).
       """
       
    1: from __future__ import annotations
       
    1: import re
       
    1: from prompt_toolkit.application.current import get_app
    1: from prompt_toolkit.filters import Condition, emacs_mode
    1: from prompt_toolkit.key_binding.key_bindings import KeyBindings
    1: from prompt_toolkit.key_binding.key_processor import KeyPressEvent
       
    1: __all__ = [
    1:     "load_auto_suggest_bindings",
       ]
       
    1: E = KeyPressEvent
       
       
    1: def load_auto_suggest_bindings() -> KeyBindings:
           """
           Key bindings for accepting auto suggestion text.
       
           (This has to come after the Vi bindings, because they also have an
           implementation for the "right arrow", but we really want the suggestion
           binding when a suggestion is available.)
           """
    2:     key_bindings = KeyBindings()
    2:     handle = key_bindings.add
       
    4:     @Condition
    4:     def suggestion_available() -> bool:
               app = get_app()
               return (
                   app.current_buffer.suggestion is not None
                   and len(app.current_buffer.suggestion.text) > 0
                   and app.current_buffer.document.is_cursor_at_the_end
               )
       
    4:     @handle("c-f", filter=suggestion_available)
    4:     @handle("c-e", filter=suggestion_available)
    4:     @handle("right", filter=suggestion_available)
    4:     def _accept(event: E) -> None:
               """
               Accept suggestion.
               """
               b = event.current_buffer
               suggestion = b.suggestion
       
               if suggestion:
                   b.insert_text(suggestion.text)
       
    4:     @handle("escape", "f", filter=suggestion_available & emacs_mode)
    4:     def _fill(event: E) -> None:
               """
               Fill partial suggestion.
               """
               b = event.current_buffer
               suggestion = b.suggestion
       
               if suggestion:
                   t = re.split(r"([^\s/]+(?:\s+|/))", suggestion.text)
                   b.insert_text(next(x for x in t if x))
       
    2:     return key_bindings
