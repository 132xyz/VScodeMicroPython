    1: from __future__ import annotations
       
    1: from prompt_toolkit.key_binding.key_processor import KeyPressEvent
    1: from prompt_toolkit.keys import Keys
       
    1: from ..key_bindings import KeyBindings
       
    1: __all__ = [
    1:     "load_cpr_bindings",
       ]
       
    1: E = KeyPressEvent
       
       
    1: def load_cpr_bindings() -> KeyBindings:
    2:     key_bindings = KeyBindings()
       
    4:     @key_bindings.add(Keys.CPRResponse, save_before=lambda e: False)
    4:     def _(event: E) -> None:
               """
               Handle incoming Cursor-Position-Request response.
               """
               # The incoming data looks like u'\x1b[35;1R'
               # Parse row/col information.
               row, col = map(int, event.data[2:-1].split(";"))
       
               # Report absolute cursor position to the renderer.
               event.app.renderer.report_absolute_cursor_row(row)
       
    2:     return key_bindings
