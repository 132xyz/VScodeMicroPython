    1: E = KeyPressEvent
       
       
    1: def if_no_repeat(event: E) -> bool:
           """Callable that returns True when the previous event was delivered to
           another handler."""
           return not event.is_repeat
       
       
    2: @Condition
    2: def has_text_before_cursor() -> bool:
           return bool(get_app().current_buffer.text)
       
       
    2: @Condition
    2: def in_quoted_insert() -> bool:
   25:     return get_app().quoted_insert
       
       
    1: def load_basic_bindings() -> KeyBindings:
    2:     key_bindings = KeyBindings()
    2:     insert_mode = vi_insert_mode | emacs_insert_mode
    2:     handle = key_bindings.add
       
