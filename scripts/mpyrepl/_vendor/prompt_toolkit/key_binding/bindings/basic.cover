    4:     @handle("<sigint>")
    4:     @handle(Keys.Ignore)
    4:     def _ignore(event: E) -> None:
               """
               First, for any of these keys, Don't do anything by default. Also don't
               catch them in the 'Any' handler which will insert them as data.
       
               If people want to insert these characters as a literal, they can always
               do by doing a quoted insert. (ControlQ in emacs mode, ControlV in Vi
               mode.)
               """
               pass
       
           # Readline-style bindings.
    2:     handle("home")(get_by_name("beginning-of-line"))
    2:     handle("end")(get_by_name("end-of-line"))
    2:     handle("left")(get_by_name("backward-char"))
    2:     handle("right")(get_by_name("forward-char"))
    2:     handle("c-up")(get_by_name("previous-history"))
    2:     handle("c-down")(get_by_name("next-history"))
    2:     handle("c-l")(get_by_name("clear-screen"))
       
    2:     handle("c-k", filter=insert_mode)(get_by_name("kill-line"))
    2:     handle("c-u", filter=insert_mode)(get_by_name("unix-line-discard"))
    4:     handle("backspace", filter=insert_mode, save_before=if_no_repeat)(
    2:         get_by_name("backward-delete-char")
           )
    4:     handle("delete", filter=insert_mode, save_before=if_no_repeat)(
    2:         get_by_name("delete-char")
           )
    4:     handle("c-delete", filter=insert_mode, save_before=if_no_repeat)(
    2:         get_by_name("delete-char")
           )
    4:     handle(Keys.Any, filter=insert_mode, save_before=if_no_repeat)(
    2:         get_by_name("self-insert")
           )
    2:     handle("c-t", filter=insert_mode)(get_by_name("transpose-chars"))
    2:     handle("c-i", filter=insert_mode)(get_by_name("menu-complete"))
    2:     handle("s-tab", filter=insert_mode)(get_by_name("menu-complete-backward"))
       
           # Control-W should delete, using whitespace as separator, while M-Del
           # should delete using [^a-zA-Z0-9] as a boundary.
    2:     handle("c-w", filter=insert_mode)(get_by_name("unix-word-rubout"))
       
    2:     handle("pageup", filter=~has_selection)(get_by_name("previous-history"))
    2:     handle("pagedown", filter=~has_selection)(get_by_name("next-history"))
       
           # CTRL keys.
       
    4:     handle("c-d", filter=has_text_before_cursor & insert_mode)(
    2:         get_by_name("delete-char")
           )
       
    4:     @handle("enter", filter=insert_mode & is_multiline)
    4:     def _newline(event: E) -> None:
               """
               Newline (in case of multiline input.
               """
               event.current_buffer.newline(copy_margin=not in_paste_mode())
       
    4:     @handle("c-j")
    4:     def _newline2(event: E) -> None:
               r"""
               By default, handle \n as if it were a \r (enter).
               (It appears that some terminals send \n instead of \r when pressing
               enter. - at least the Linux subsystem for Windows.)
               """
               event.key_processor.feed(KeyPress(Keys.ControlM, "\r"), first=True)
       
           # Delete the word before the cursor.
       
    4:     @handle("up")
    4:     def _go_up(event: E) -> None:
               event.current_buffer.auto_up(count=event.arg)
       
    4:     @handle("down")
    4:     def _go_down(event: E) -> None:
               event.current_buffer.auto_down(count=event.arg)
       
    4:     @handle("delete", filter=has_selection)
    4:     def _cut(event: E) -> None:
               data = event.current_buffer.cut_selection()
               event.app.clipboard.set_data(data)
       
           # Global bindings.
       
    4:     @handle("c-z")
    4:     def _insert_ctrl_z(event: E) -> None:
               """
               By default, control-Z should literally insert Ctrl-Z.
               (Ansi Ctrl-Z, code 26 in MSDOS means End-Of-File.
               In a Python REPL for instance, it's possible to type
               Control-Z followed by enter to quit.)
       
               When the system bindings are loaded and suspend-to-background is
               supported, that will override this binding.
               """
               event.current_buffer.insert_text(event.data)
       
    4:     @handle(Keys.BracketedPaste)
    4:     def _paste(event: E) -> None:
               """
               Pasting from clipboard.
               """
               data = event.data
       
               # Be sure to use \n as line ending.
               # Some terminals (Like iTerm2) seem to paste \r\n line endings in a
               # bracketed paste. See: https://github.com/ipython/ipython/issues/9737
               data = data.replace("\r\n", "\n")
               data = data.replace("\r", "\n")
       
               event.current_buffer.insert_text(data)
       
    4:     @handle(Keys.Any, filter=in_quoted_insert, eager=True)
    4:     def _insert_text(event: E) -> None:
               """
               Handle quoted insert.
               """
               event.current_buffer.insert_text(event.data, overwrite=False)
               event.app.quoted_insert = False
       
    2:     return key_bindings
