    1: from operator import itemgetter
       
    1: CS_ESCAPE = re.compile(r'[\[\^\\\-\]]')
    1: FIRST_ELEMENT = itemgetter(0)
       
       
    1: def commonprefix(m):
           """Given an iterable of strings, returns the longest common leading substring"""
  666:     if not m:
               return ""
  666:     s1 = min(m)
  666:     s2 = max(m)
  915:     for i, c in enumerate(s1):
  899:         if c != s2[i]:
  650:             return s1[:i]
   16:     return s1
       
       
    1: def make_charset(letters):
    7:     return '[' + CS_ESCAPE.sub(lambda m: '\\' + m.group(), ''.join(letters)) + ']'
       
       
    1: def regex_opt_inner(strings, open_paren):
           """Return a regex that matches any string in the sorted list of strings."""
  672:     close_paren = open_paren and ')' or ''
           # print strings, repr(open_paren)
  672:     if not strings:
               # print '-> nothing left'
               return ''
  672:     first = strings[0]
  672:     if len(strings) == 1:
               # print '-> only 1 string'
  258:         return open_paren + escape(first) + close_paren
  414:     if not first:
               # print '-> first string empty'
   48:         return open_paren + regex_opt_inner(strings[1:], '(?:') \
   32:             + '?' + close_paren
  398:     if len(first) == 1:
               # multiple one-char strings? make a charset
   18:         oneletter = []
   18:         rest = []
   69:         for s in strings:
   51:             if len(s) == 1:
   25:                 oneletter.append(s)
                   else:
   26:                 rest.append(s)
   18:         if len(oneletter) > 1:  # do we have more than one oneletter string?
    7:             if rest:
                       # print '-> 1-character + rest'
    9:                 return open_paren + regex_opt_inner(rest, '') + '|' \
    6:                     + make_charset(oneletter) + close_paren
                   # print '-> only 1-character'
    4:             return open_paren + make_charset(oneletter) + close_paren
  391:     prefix = commonprefix(strings)
  391:     if prefix:
  116:         plen = len(prefix)
               # we have a prefix for all strings
               # print '-> prefix:', prefix
  348:         return open_paren + escape(prefix) \
  612:             + regex_opt_inner([s[plen:] for s in strings], '(?:') \
  116:             + close_paren
           # is there a suffix?
 3750:     strings_rev = [s[::-1] for s in strings]
  275:     suffix = commonprefix(strings_rev)
  275:     if suffix:
   21:         slen = len(suffix)
               # print '-> suffix:', suffix[::-1]
   84:         return open_paren \
  205:             + regex_opt_inner(sorted(s[:-slen] for s in strings), '(?:') \
   42:             + escape(suffix[::-1]) + close_paren
           # recurse on common 1-string prefixes
           # print '-> last resort'
  762:     return open_paren + \
 1270:         '|'.join(regex_opt_inner(list(group[1]), '')
 4328:                  for group in groupby(strings, lambda s: s[0] == first[0])) \
  254:         + close_paren
       
       
    1: def regex_opt(strings, prefix='', suffix=''):
           """Return a compiled regex that matches any string in the given list.
       
           The strings to match must be literal strings, not regexes.  They will be
           regex-escaped.
       
           *prefix* and *suffix* are pre- and appended to the final regex.
           """
    8:     strings = sorted(strings)
    8:     return prefix + regex_opt_inner(strings, '(') + suffix
